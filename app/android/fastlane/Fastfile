default_platform(:android)

platform :android do
  desc "Upload the signed app bundle to the Play internal testing track"
  lane :release do
    upload_to_play_store(
      package_name: "com.boundfoxstudios.apps.flugwacht",
      track: "internal",
      # fastlane runs actions chdir'd to app/android, so this resolves to
      # app/build/... — the redirected Flutter build directory, not app/android/build
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV.fetch("PLAY_STORE_CREDENTIALS"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
