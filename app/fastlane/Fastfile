platform :ios do
  desc "Build a signed IPA without uploading it"
  lane :build do
    build_signed_ipa
  end

  desc "Build a signed IPA and upload it to TestFlight"
  lane :release do
    build_signed_ipa

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  # Automatic signing would mint a fresh development certificate on every
  # ephemeral runner and eventually exhaust the account's certificate quota,
  # so the archive signs manually with the imported distribution identity
  private_lane :build_signed_ipa do
    app_identifier = "com.boundfoxstudios.apps.flugwacht"

    # The Live Activity ships as its own binary inside the app, so it carries
    # its own app id and its own profile; gym has to be handed both
    signed_targets = {
      "Runner" => {
        app_identifier: app_identifier,
        profile_name: "Flugwacht App Store"
      },
      "FlugwachtLiveActivityExtension" => {
        app_identifier: "#{app_identifier}.live",
        profile_name: "Flugwacht Live Activity App Store"
      }
    }

    setup_ci

    key_id = ENV.fetch("APPLE_APP_STORE_CONNECT_KEY_ID")
    issuer_id = ENV.fetch("APPLE_APP_STORE_CONNECT_ISSUER_ID")
    key_path = File.join(ENV.fetch("RUNNER_TEMP"), "AuthKey.p8")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    import_certificate(
      certificate_path: File.join(ENV.fetch("RUNNER_TEMP"), "distribution.p12"),
      certificate_password: ENV.fetch("APPLE_CERTIFICATE_PASSPHRASE"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    signed_targets.each do |target, signing|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: signing[:app_identifier],
        team_id: team_id,
        provisioning_name: signing[:profile_name],
        ignore_profiles_with_different_name: true,
        # Without this, an unusable same-named portal profile (e.g. after a
        # certificate rotation) makes sigh silently create a timestamp-suffixed
        # profile that no longer matches the pinned name below
        fail_on_name_taken: true
      )

      update_code_signing_settings(
        path: "ios/Runner.xcodeproj",
        use_automatic_signing: false,
        team_id: team_id,
        targets: [target],
        code_sign_identity: "Apple Distribution",
        profile_name: signing[:profile_name]
      )
    end

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        provisioningProfiles: signed_targets.values.to_h do |signing|
          [signing[:app_identifier], signing[:profile_name]]
        end
      }
    )
  end
end

platform :android do
  desc "Upload the signed app bundle to the Play internal testing track"
  lane :release do
    upload_to_play_store(
      package_name: "com.boundfoxstudios.apps.flugwacht",
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV.fetch("PLAY_STORE_CREDENTIALS"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
