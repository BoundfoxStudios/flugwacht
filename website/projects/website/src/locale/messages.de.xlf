<?xml version="1.0" encoding="UTF-8" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="en" target-language="de" datatype="plaintext" original="ng2.template">
    <body>
      <trans-unit id="features.heading" datatype="html">
        <source>Features at a glance.</source>
        <target>Funktionen auf einen Blick.</target>
      </trans-unit>
      <trans-unit id="features.map.title" datatype="html">
        <source>Live on the map</source>
        <target>Live auf der Karte</target>
      </trans-unit>
      <trans-unit id="features.map.text" datatype="html">
        <source>Follow several flights at once on OpenStreetMap, from takeoff to landing.</source>
        <target>Verfolge mehrere Flüge gleichzeitig auf OpenStreetMap, vom Start bis zur Landung.</target>
      </trans-unit>
      <trans-unit id="features.notify.title" datatype="html">
        <source>Get notified</source>
        <target>Bleib informiert</target>
      </trans-unit>
      <trans-unit id="features.notify.text" datatype="html">
        <source>You get a notification at takeoff, shortly before arrival, and after landing.</source>
        <target>Du bekommst eine Mitteilung beim Start, kurz vor der Ankunft und nach der Landung.</target>
      </trans-unit>
      <trans-unit id="features.private.title" datatype="html">
        <source>Private by design</source>
        <target>Privatsphäre ab Werk</target>
      </trans-unit>
      <trans-unit id="features.private.text" datatype="html">
        <source>Flugwacht works without an account and doesn&apos;t track you. Your flights are only stored on your device.</source>
        <target>Flugwacht funktioniert ohne Konto und trackt dich nicht. Deine Flüge sind nur auf deinem Gerät gespeichert.</target>
      </trans-unit>
      <trans-unit id="footer.tagline" datatype="html">
        <source>A simple flight tracker for friends and family.</source>
        <target>Ein einfacher Flugtracker für Freunde und Familie.</target>
      </trans-unit>
      <trans-unit id="footer.getTheApp" datatype="html">
        <source>GET THE APP</source>
        <target>APP LADEN</target>
      </trans-unit>
      <trans-unit id="footer.community" datatype="html">
        <source>COMMUNITY</source>
        <target>COMMUNITY</target>
      </trans-unit>
      <trans-unit id="footer.legal" datatype="html">
        <source>LEGAL</source>
        <target>RECHTLICHES</target>
      </trans-unit>
      <trans-unit id="footer.imprint" datatype="html">
        <source>Imprint</source>
        <target>Impressum</target>
      </trans-unit>
      <trans-unit id="footer.privacy" datatype="html">
        <source>Privacy Policy</source>
        <target>Datenschutzerklärung</target>
      </trans-unit>
      <trans-unit id="footer.boundfoxProject" datatype="html">
        <source>A Boundfox Studios project</source>
        <target>Ein Projekt von Boundfox Studios</target>
      </trans-unit>
      <trans-unit id="footer.mapData" datatype="html">
        <source>Map data © OpenStreetMap contributors</source>
        <target>Kartendaten © OpenStreetMap-Mitwirkende</target>
      </trans-unit>
      <trans-unit id="hero.badge" datatype="html">
        <source>FREE &amp; OPEN SOURCE</source>
        <target>KOSTENLOS &amp; OPEN SOURCE</target>
      </trans-unit>
      <trans-unit id="hero.title" datatype="html">
        <source>Simply track your <x id="LINE_BREAK" ctype="lb" equiv-text="&lt;br /&gt;"/>friends&apos; flights.</source>
        <target>Verfolge einfach die <x id="LINE_BREAK" ctype="lb" equiv-text="&lt;br /&gt;"/>Flüge deiner Freunde.</target>
      </trans-unit>
      <trans-unit id="hero.teaser" datatype="html">
        <source>Flugwacht is a minimal flight tracker for the flights you actually care about. No account, no ads, everything stays on your device. The flight data comes from community-run ADS-B networks.</source>
        <target>Flugwacht ist ein minimaler Flugtracker für die Flüge, die dir wirklich wichtig sind. Ohne Konto, ohne Werbung, alles bleibt auf deinem Gerät. Die Flugdaten kommen aus Community-ADS-B-Netzwerken.</target>
      </trans-unit>
      <trans-unit id="hero.appStoreAlt" datatype="html">
        <source>Download on the App Store</source>
        <target>Laden im App Store</target>
      </trans-unit>
      <trans-unit id="hero.playStoreAlt" datatype="html">
        <source>Get it on Google Play</source>
        <target>Jetzt bei Google Play</target>
      </trans-unit>
      <trans-unit id="nav.features" datatype="html">
        <source>Features</source>
        <target>Funktionen</target>
      </trans-unit>
      <trans-unit id="nav.howItWorks" datatype="html">
        <source>How it works</source>
        <target>So funktioniert's</target>
      </trans-unit>
      <trans-unit id="nav.faq" datatype="html">
        <source>FAQ</source>
        <target>FAQ</target>
      </trans-unit>
      <trans-unit id="screenshots.heading" datatype="html">
        <source>A look at the app.</source>
        <target>Ein Blick in die App.</target>
      </trans-unit>
      <trans-unit id="screenshots.map" datatype="html">
        <source>Map &amp; arrival</source>
        <target>Karte &amp; Ankunft</target>
      </trans-unit>
      <trans-unit id="screenshots.today" datatype="html">
        <source>Today&apos;s flights</source>
        <target>Deine Flüge heute</target>
      </trans-unit>
      <trans-unit id="screenshots.add" datatype="html">
        <source>Add a flight</source>
        <target>Flug hinzufügen</target>
      </trans-unit>
    </body>
