      <trans-unit id="faq.which.question" datatype="html">
        <source>Which flights can I track?</source>
        <context-group purpose="location">
          <context context-type="sourcefile">projects/website/src/app/faq/faq.ts</context>
          <context context-type="linenumber">16</context>
        </context-group>
      </trans-unit>
      <trans-unit id="faq.which.answer" datatype="html">
        <source>Every flight that broadcasts ADS-B, which is nearly every airliner worldwide. You can add a flight by its flight number, registration or hex code.</source>
        <context-group purpose="location">
          <context context-type="sourcefile">projects/website/src/app/faq/faq.ts</context>
          <context context-type="linenumber">17</context>
