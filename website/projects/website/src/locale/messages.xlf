          <context context-type="sourcefile">projects/website/src/app/faq/faq.ts</context>
          <context context-type="linenumber">20</context>
        </context-group>
      </trans-unit>
      <trans-unit id="faq.noSignal.answer" datatype="html">
        <source>Over oceans and in remote areas there are fewer receivers, so short gaps are normal. The flight reappears once it&apos;s back in range.</source>
        <context-group purpose="location">
          <context context-type="sourcefile">projects/website/src/app/faq/faq.ts</context>
          <context context-type="linenumber">21</context>
        </context-group>
